# Projeto Supabase "MenuNext" (dedicado e exclusivo — nunca reutilizar outro projeto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — só necessária se algum restaurante ativar o método de frete
# "Por KM" em /painel/delivery (Fase 4.1.1). Sem esta chave, "Por KM" fica
# indisponível na tela de configuração (mensagem explicando o motivo) e a
# taxa fixa continua funcionando normalmente, sem qualquer dependência
# externa. NUNCA prefixar com NEXT_PUBLIC_ — é lida somente no servidor
# (src/lib/geocoding.ts), nunca enviada ao navegador do cliente.
# Como obter: https://developers.google.com/maps/documentation/geocoding/get-api-key
GOOGLE_MAPS_GEOCODING_API_KEY=

# Opcional — só necessária para a assinatura SaaS do lojista em
# /painel/plano (cobrança do MenuNext, nunca os pedidos dos clientes finais,
# que continuam Pix direto sem gateway). Sem esta chave, "Assinar plano"
# mostra um aviso de "ainda não configurado" em vez de fingir sucesso.
# NUNCA prefixar com NEXT_PUBLIC_ — lida só no servidor (src/lib/asaas.ts).
# Como obter: https://www.asaas.com (conta sandbox para testes: https://sandbox.asaas.com)
ASAAS_API_KEY=
# "sandbox" (padrão/mais seguro) ou "production".
ASAAS_ENV=sandbox

# Chave de SERVIDOR do Supabase (service_role). Só o backend de cobrança a usa:
# registrar a assinatura depois de provada na API do Asaas e reconciliar
# pagamentos (src/lib/supabase/admin.ts). Ignora RLS: NUNCA prefixar com
# NEXT_PUBLIC_, nunca usar no navegador e nunca commitar. Sem ela (ou sem a
# ASAAS_API_KEY) a cobrança de assinaturas fica desligada e nada é criado no Asaas.
# Onde obter: Supabase -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo da rotina agendada de reconciliação com o Asaas
# (/api/cron/billing-reconcile, agendada em vercel.json). Use um valor aleatório
# com 16+ caracteres; o Vercel Cron o envia como "Authorization: Bearer <valor>".
# Sem ele a rota recusa tudo (503).
CRON_SECRET=

# Não há variável de ambiente para o token de webhook — ele é configurado
# em /master/assinaturas (salvo em billing_settings) e comparado lá dentro
# das RPCs billing_webhook_token_valid / process_asaas_webhook. Gere um valor aleatório e cole o MESMO
# valor em /master/assinaturas e na config de webhook do painel Asaas
# (Integrações → Webhooks → Token de acesso).


# Opcional — envio de e-mail transacional (hoje: convites da equipe) pelo Resend.
# Só funciona com AS DUAS variáveis; sem elas nada é enviado e o dono continua
# copiando o link do convite à mão. EMAIL_FROM precisa ser um remetente de
# DOMÍNIO VERIFICADO no Resend (ex.: "MenuNext <convites@seudominio.com.br>").
# NUNCA prefixar com NEXT_PUBLIC_ — lidas só no servidor (src/lib/email.ts).
# Atenção: ativar o envio inclui o Resend entre os operadores de dados pessoais
# (e-mail do convidado); atualize a Política de Privacidade antes de ativar.
RESEND_API_KEY=
EMAIL_FROM=

# Opcional — verificação anti-robô (Cloudflare Turnstile) em cadastro, login e recuperação de senha.
# Só liga com AS DUAS chaves (crie um widget em dash.cloudflare.com > Turnstile). Ligada, falha fechado:
# sem token válido a ação é negada. TURNSTILE_SECRET_KEY é de servidor: nunca prefixar com NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
